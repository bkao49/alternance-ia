# Copier en .env (jamais commité : .env est ignoré par git). Valeurs vides = secrets à générer.
# Générer un secret : python -c "import secrets; print(secrets.token_hex(32))"
# (Sous Windows sans Python : docker run --rm python:3.12-slim python -c "import secrets; print(secrets.token_hex(32))")

# --- Base de données (docker compose) ---
# Mot de passe du propriétaire de la base : sert uniquement aux migrations.
POSTGRES_PASSWORD=
# Mot de passe du rôle « app » utilisé par l'API (distinct du propriétaire). Utiliser une valeur hexadécimale.
APP_DB_PASSWORD=
# docker compose construit lui-même les deux URL ci-dessous à partir des mots de passe. À définir à la main
# seulement pour lancer le backend hors Docker :
#   MIGRATION_DATABASE_URL = propriétaire des tables, pour « alembic upgrade head »
#   DATABASE_URL           = rôle de connexion de l'API (membre de app_rw, sans BYPASSRLS)
# MIGRATION_DATABASE_URL=postgresql://owner:...@localhost:5432/app
# DATABASE_URL=postgresql://app:...@localhost:5432/app

# --- API ---
# Port local de docker compose uniquement (le conteneur écoute toujours sur 8000)
API_PORT=8100
# Clé de signature des sessions : 32 caractères minimum.
SECRET_KEY=
# false uniquement en développement local en http (le cookie « Secure » n'est pas renvoyé en http).
# En production (https) : true.
COOKIE_SECURE=false
# Autorise « python -m app.seed_demo » (données fictives). Laisser à false hors démonstration.
ALLOW_DEMO_DATA=false
# Durées de conservation en jours (RGPD, docs/security/retention.md) : offres non retenues, journal et cache IA.
RETENTION_OFFERS_DAYS=180
RETENTION_LLM_DAYS=90

# --- Intégrations futures (laisser vide pour l'instant) ---
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
LBA_API_TOKEN=
LLM_PROVIDER=gemini
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
LLM_MONTHLY_BUDGET_EUR=10
# Plafond de coût LLM par utilisateur et par jour (euros), appliqué par la passerelle (backend/app/ai/gateway).
LLM_DAILY_CAP_EUR=0.50
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
