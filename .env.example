# Copier en .env (jamais commité : .env est ignoré par git). Valeurs vides = secrets à générer.
# Générer un secret : python -c "import secrets; print(secrets.token_hex(32))"
# (Sous Windows sans Python : docker run --rm python:3.12-slim python -c "import secrets; print(secrets.token_hex(32))")

# --- Base de données (docker compose) ---
# Mot de passe du propriétaire de la base : sert uniquement aux migrations.
POSTGRES_PASSWORD=
# Mot de passe du rôle « app » utilisé par l'API (distinct du propriétaire). Utiliser une valeur hexadécimale.
APP_DB_PASSWORD=
# docker compose construit lui-même les deux URL ci-dessous à partir des mots de passe. À définir à la main
# seulement pour lancer le backend hors Docker :
#   MIGRATION_DATABASE_URL = propriétaire des tables, pour « alembic upgrade head »
#   DATABASE_URL           = rôle de connexion de l'API (membre de app_rw, sans BYPASSRLS)
# MIGRATION_DATABASE_URL=postgresql://owner:...@localhost:5432/app
# DATABASE_URL=postgresql://app:...@localhost:5432/app

# --- API ---
# Port local de docker compose uniquement (le conteneur écoute toujours sur 8000)
API_PORT=8100
# Clé de signature des sessions : 32 caractères minimum.
SECRET_KEY=
# false uniquement en développement local en http (le cookie « Secure » n'est pas renvoyé en http).
# En production (https) : true.
COOKIE_SECURE=false
# Autorise « python -m app.seed_demo » (données fictives). Laisser à false hors démonstration.
ALLOW_DEMO_DATA=false
# Durées de conservation en jours (RGPD, docs/security/retention.md) : offres non retenues, journal et cache IA.
RETENTION_OFFERS_DAYS=180
RETENTION_LLM_DAYS=90

# Intervalle de collecte par défaut du worker, en minutes (minimum 60).
COLLECT_INTERVAL_MINUTES=120

# --- Intégrations futures (laisser vide pour l'instant) ---
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
LBA_API_TOKEN=
# Adzuna (API officielle gratuite, compte sur developer.adzuna.com) : laisser vide sans compte.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Boîte dédiée aux alertes e-mail (jamais la boîte personnelle) : laisser vide sans boîte. Utiliser un mot de passe
# d'application. Réservé au contrôle « doctor » : chaque utilisateur saisit sa boîte dans « Mes sources » (docs/sources/email.md).
EMAIL_ALERTS_HOST=
EMAIL_ALERTS_PORT=
EMAIL_ALERTS_USER=
EMAIL_ALERTS_PASSWORD=
EMAIL_ALERTS_FOLDER=
# Vérifie que l'expéditeur n'est pas falsifié (true par défaut ; false si des e-mails redirigés sont refusés).
EMAIL_ALERTS_REQUIRE_AUTH=
# Identifiant du serveur de messagerie dans l'en-tête Authentication-Results de vos e-mails (voir la fiche).
EMAIL_ALERTS_AUTHSERV_ID=
# Domaines d'envoi à remplacer pour un site, séparés par des virgules (ex. EMAIL_ALERTS_DOMAINS_INDEED=).
# --- IA (passerelle backend/app/ai/gateway) ---
# anthropic = Claude ; vide = IA désactivée. Clé à créer sur console.anthropic.com (jamais dans git).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Modèles par tâche : rapide pour l'extraction et les vérifications, qualité pour les CV et les lettres.
# ANTHROPIC_MODEL_FAST=claude-haiku-5-5
# ANTHROPIC_MODEL_QUALITY=claude-sonnet-5-5
# Tarifs en euros par million de jetons (à revérifier sur anthropic.com/pricing) :
# ANTHROPIC_EUR_PER_MTOK_FAST_IN=1
# ANTHROPIC_EUR_PER_MTOK_FAST_OUT=5
# ANTHROPIC_EUR_PER_MTOK_QUALITY_IN=3
# ANTHROPIC_EUR_PER_MTOK_QUALITY_OUT=15
LLM_MONTHLY_BUDGET_EUR=10
# Plafond de coût LLM par utilisateur et par jour (euros), appliqué par la passerelle (backend/app/ai/gateway).
LLM_DAILY_CAP_EUR=0.50
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
